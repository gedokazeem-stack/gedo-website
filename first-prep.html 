let index=0, answers=Array(Q.length).fill(null);
const $=id=>document.getElementById(id);
$('begin').onclick=()=>{$('start').classList.add('hidden');$('quiz').classList.remove('hidden');render()};
function render(){
 const x=Q[index];$('subject').textContent=x.s;$('counter').textContent=`السؤال ${index+1} من ${Q.length}`;
 $('bar').style.width=((index+1)/Q.length*100)+'%';$('question').textContent=x.q;$('choices').innerHTML='';
 x.a.forEach((v,i)=>{let l=document.createElement('label');l.className='choice';let inp=document.createElement('input');inp.type='radio';inp.name='answer';inp.value=i;inp.checked=answers[index]===i;inp.onchange=()=>answers[index]=i;l.append(inp,document.createTextNode(v));$('choices').append(l)});
 $('prev').disabled=index===0;$('next').classList.toggle('hidden',index===Q.length-1);$('finish').classList.toggle('hidden',index!==Q.length-1);
}
$('prev').onclick=()=>{if(index>0){index--;render()}};
$('next').onclick=()=>{if(index<Q.length-1){index++;render()}};
$('finish').onclick=finish;
function finish(){
 const unanswered=answers.filter(x=>x===null).length;
 if(unanswered && !confirm(`متبقي ${unanswered} سؤال بدون إجابة. هل تريد إنهاء الامتحان؟`))return;
 let score=0;Q.forEach((q,i)=>{if(answers[i]===q.c)score++});
 $('quiz').classList.add('hidden');$('result').classList.remove('hidden');$('review').classList.remove('hidden');
 $('score').textContent=`${score} / ${Q.length}`;$('percent').textContent=`النسبة المئوية: ${score}%`;$('summary').textContent=`إجابات صحيحة: ${score} — إجابات خاطئة أو غير مجابة: ${Q.length-score}`;
 $('details').innerHTML='';
 Q.forEach((q,i)=>{
  const ok=answers[i]===q.c;let div=document.createElement('div');div.className='review-item';
  let title=document.createElement('b');title.textContent=`${i+1}) ${q.s} — ${q.q}`;div.append(title);
  let yours=document.createElement('p');yours.className=ok?'correct':'wrong';yours.textContent=`إجابتك: ${answers[i]===null?'لم تجب':q.a[answers[i]]} ${ok?'✓':'✗'}`;div.append(yours);
  let right=document.createElement('p');right.className='correct';right.textContent=`الإجابة الصحيحة: ${q.a[q.c]}`;div.append(right);
  let ex=document.createElement('div');ex.className='explain';ex.textContent='التفسير: '+q.e+' توضيح الاختيارات الأخرى: '+q.a.map((v,j)=>j===q.c?'':`«${v}» غير صحيحة هنا.`).filter(Boolean).join(' ');div.append(ex);$('details').append(div);
 });
 window.scrollTo(0,0);
}
