let current = 0;
const answers = new Array(questions.length).fill(-1);
const counter = document.getElementById('counter');
const scoreLive = document.getElementById('scoreLive');
const bar = document.getElementById('bar');
const subject = document.getElementById('subject');
const question = document.getElementById('question');
const choices = document.getElementById('choices');
const prev = document.getElementById('prev');
const next = document.getElementById('next');

function renderQuestion() {
  const item = questions[current];
  counter.textContent = 'السؤال ' + (current + 1) + ' من ' + questions.length;
  scoreLive.textContent = 'تمت الإجابة: ' + answers.filter(function(value) { return value !== -1; }).length;
  bar.style.width = ((current + 1) / questions.length * 100) + '%';
  subject.textContent = item.subject;
  question.textContent = item.q;
  choices.innerHTML = '';
  item.choices.forEach(function(choice, index) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'choice' + (answers[current] === index ? ' selected' : '');
    button.textContent = String.fromCharCode(65 + index) + ') ' + choice;
    button.addEventListener('click', function() {
      answers[current] = index;
      renderQuestion();
    });
    choices.appendChild(button);
  });
  prev.disabled = current === 0;
  next.textContent = current === questions.length - 1 ? 'إنهاء الامتحان' : 'التالي';
}
prev.addEventListener('click', function() {
  if (current > 0) { current--; renderQuestion(); }
});
next.addEventListener('click', function() {
  if (current < questions.length - 1) {
    current++;
    renderQuestion();
  } else {
    finishExam();
  }
});
function finishExam() {
  const answered = answers.filter(function(value) { return value !== -1; }).length;
  if (answered < questions.length) {
    const confirmFinish = confirm('أجبت عن ' + answered + ' سؤالًا من 100. هل تريد إنهاء الامتحان؟');
    if (!confirmFinish) return;
  }
  let score = 0;
  questions.forEach(function(item, index) {
    if (answers[index] === item.answer) score++;
  });
  document.getElementById('exam').style.display = 'none';
  document.getElementById('result').style.display = 'block';
  document.getElementById('finalScore').textContent = score + ' / 100';
  document.getElementById('summary').textContent = 'إجابات صحيحة: ' + score + ' – إجابات خاطئة أو غير مجابة: ' + (100 - score);
  const review = document.getElementById('review');
  review.innerHTML = '';
  questions.forEach(function(item, index) {
    const box = document.createElement('div');
    box.className = 'review ' + (answers[index] === item.answer ? 'correct' : 'wrong');
    const yourAnswer = answers[index] === -1 ? 'لم تتم الإجابة' : item.choices[answers[index]];
    box.textContent = (index + 1) + '. ' + item.q + ' | إجابتك: ' + yourAnswer + ' | الصحيحة: ' + item.choices[item.answer] + ' | التوضيح: ' + item.explain;
    review.appendChild(box);
  });
  window.scrollTo(0,0);
}
renderQuestion();
</script>
