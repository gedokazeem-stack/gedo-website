
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#10234b">
<title>سَنَد | SANAD</title>
<style>
:root{
--bg:#f2f5fb;--card:#fff;--text:#17243d;--muted:#748197;
--primary:#173b72;--accent:#0d9488;--line:#e2e9f2;
--danger:#dc3545;--shadow:0 5px 22px #17243d0b
}
.dark{
--bg:#101827;--card:#1c293d;--text:#edf3ff;--muted:#a9b6ca;
--primary:#7ba8ed;--accent:#35c6b4;--line:#34445a;
--shadow:0 5px 22px #0003
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
font-family:Tahoma,Arial,sans-serif;transition:.2s}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
header{
background:linear-gradient(130deg,#10234b,#174b78);
color:white;padding:18px 5% 24px
}
.top{display:flex;justify-content:space-between;align-items:center;gap:10px}
.made{font-size:11px;letter-spacing:2px;color:#9ed9e9;font-weight:bold}
.logo{font-size:29px;font-weight:900;margin-top:7px}
.logo small{display:block;font-size:11px;color:#c2d9eb;font-weight:normal}
.top button{background:#ffffff20;color:white;border:1px solid #ffffff40;
padding:9px 12px;border-radius:12px}
.hero{padding:23px 0 0}
.hero h1{font-size:clamp(23px,5vw,36px);margin:0 0 10px}
.hero p{color:#d4e4f5;line-height:1.8;margin:0}
.search{width:100%;margin-top:18px;padding:15px;border:0;
border-radius:13px;outline:none;background:white;color:#17243d}
.container{max-width:1050px;margin:auto;padding:18px 14px 100px}
.section-title{font-size:20px;margin:24px 0 13px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
@media(min-width:700px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
.card{background:var(--card);border:1px solid var(--line);
border-radius:17px;padding:16px;box-shadow:var(--shadow)}
.tile{cursor:pointer;min-height:135px;transition:.2s}
.tile:hover{transform:translateY(-3px)}
.emoji{font-size:28px;margin-bottom:9px}
.tile b{display:block;font-size:15px}
.tile small{display:block;color:var(--muted);margin-top:7px;line-height:1.6}
.page{display:none}
.page.active{display:block}
button.primary{background:var(--primary);color:white;border:0;
padding:11px 15px;border-radius:10px}
button.secondary{background:var(--bg);color:var(--text);
border:1px solid var(--line);padding:10px 13px;border-radius:10px}
button.success{background:var(--accent);color:white;border:0;
padding:11px 14px;border-radius:10px}
button.danger{background:var(--danger);color:white;border:0;
padding:10px 14px;border-radius:10px}
.back{margin-bottom:16px}
.muted{color:var(--muted);font-size:13px;line-height:1.8}
input,select,textarea{width:100%;padding:12px;border-radius:10px;
border:1px solid var(--line);background:var(--bg);color:var(--text);
margin:6px 0 12px;outline:none}
label{font-size:13px;color:var(--muted)}
.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
.row>*{flex:1}
.item{display:flex;justify-content:space-between;align-items:center;
gap:8px;padding:13px 0;border-bottom:1px solid var(--line)}
.item:last-child{border:0}
.number{font-size:23px;font-weight:bold;direction:ltr;display:inline-block}
.call{background:#dc3545;color:white;padding:9px 12px;
border-radius:9px;text-decoration:none;font-size:13px}
.copy{background:var(--bg);color:var(--text);border:1px solid var(--line);
border-radius:9px;padding:8px 12px}
.notice{background:#fff3d9;color:#79551c;padding:13px;
border-radius:12px;line-height:1.9;font-size:13px;margin:12px 0}
.dark .notice{background:#493a20;color:#ffe2a0}
.result{font-size:18px;font-weight:bold;color:var(--accent);margin:13px 0}
.clock{background:linear-gradient(140deg,#173b72,#0d9488);
color:white;border:0;text-align:center}
.clock .time{font-size:27px;font-weight:bold;direction:ltr}
.clock .date{font-size:12px;opacity:.85;margin-top:7px}
.tabs{position:fixed;bottom:0;left:0;right:0;background:var(--card);
border-top:1px solid var(--line);display:flex;justify-content:space-around;
padding:9px 2px calc(9px + env(safe-area-inset-bottom));z-index:5}
.tabs button{border:0;background:none;color:var(--muted);font-size:11px;
display:flex;flex-direction:column;align-items:center;gap:4px}
.tabs button span{font-size:20px}
.tabs button.selected{color:var(--accent);font-weight:bold}
.hidden{display:none!important}
hr{border:0;border-top:1px solid var(--line);margin:15px 0}
footer{text-align:center;color:var(--muted);font-size:12px;padding:20px}
</style>
</head>
<body>

<header>
 <div class="top">
  <div>
   <div class="made">✦ MADE BY GEDO ✦</div>
   <div class="logo">سَـنَـد <small>SANAD | دليلك للحياة اليومية</small></div>
  </div>
  <button onclick="toggleDark()">🌙 الوضع الليلي</button>
 </div>
 <div class="hero">
  <h1>المعلومة الصح في الوقت الصح.</h1>
  <p>خدمات وأدوات ومعلومات تساعدك في حياتك اليومية.</p>
  <input class="search" id="search" placeholder="🔍 ابحث عن خدمة أو معلومة..."
   oninput="searchAll(this.value)">
 </div>
</header>

<main class="container">

<!-- الرئيسية -->
<section class="page active" id="home">
 <h2 class="section-title">ماذا تحتاج اليوم؟</h2>
 <div class="grid" id="mainTiles">
  <div class="card tile" data-search="طوارئ إسعاف شرطة مطافئ">
   <div class="emoji">🚨</div><b>أرقام الطوارئ</b>
   <small>أرقام مهمة في مصر.</small>
   <button class="primary" onclick="showPage('emergency')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="إسعافات حروق إغماء اختناق تشنجات حريق">
   <div class="emoji">🩺</div><b>التصرف وقت الخطر</b>
   <small>إرشادات أولية للمواقف المفاجئة.</small>
   <button class="primary" onclick="showPage('firstaid')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="فودافون اورنج اتصالات وي أكواد رصيد">
   <div class="emoji">📱</div><b>أكواد الشبكات</b>
   <small>شركات المحمول المصرية.</small>
   <button class="primary" onclick="showPage('codes')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="العمر ميلاد تاريخ سنة شهر">
   <div class="emoji">🎂</div><b>احسب عمرك</b>
   <small>عمرك ومفاجأة يوم ميلادك.</small>
   <button class="primary" onclick="showPage('age')">احسب الآن</button>
  </div>
  <div class="card tile" data-search="QR كيو ار رابط نص">
   <div class="emoji">🔳</div><b>صانع QR</b>
   <small>إنشاء رموز QR للنصوص والروابط القصيرة.</small>
   <button class="primary" onclick="showPage('qr')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="ساعة عالمية توقيت القاهرة نيوزيلندا نزلة سلمان باريس">
   <div class="emoji">🌍</div><b>الساعة العالمية</b>
   <small>اعرف الوقت في مدن العالم ونزلة سلمان.</small>
   <button class="primary" onclick="showPage('world')">افتح الساعة</button>
  </div>
  <div class="card tile" data-search="حاسبة حساب آلة حاسبة">
   <div class="emoji">🧮</div><b>الحاسبة</b>
   <small>عمليات حسابية سريعة.</small>
   <button class="primary" onclick="showPage('calculator')">افتح الحاسبة</button>
  </div>
  <div class="card tile" data-search="تحويل وحدات طول وزن حرارة مساحة">
   <div class="emoji">📏</div><b>محوّل الوحدات</b>
   <small>تحويل وحدات القياس.</small>
   <button class="primary" onclick="showPage('convert')">افتح المحوّل</button>
  </div>
  <div class="card tile" data-search="كلمة مرور باسورد">
   <div class="emoji">🔐</div><b>مولّد كلمات المرور</b>
   <small>إنشاء كلمات مرور عشوائية.</small>
   <button class="primary" onclick="showPage('password')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="مناسبات عداد وقت">
   <div class="emoji">⏳</div><b>عداد المناسبات</b>
   <small>احسب الوقت المتبقي لأي موعد.</small>
   <button class="primary" onclick="showPage('countdown')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="تاريخ الأيام حاسبة تاريخ">
   <div class="emoji">📅</div><b>حاسبة التاريخ</b>
   <small>الفرق بين تاريخين.</small>
   <button class="primary" onclick="showPage('datecalc')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="ملاحظات خزنة بيانات">
   <div class="emoji">📝</div><b>ملاحظاتي</b>
   <small>احفظ ملاحظاتك على جهازك.</small>
   <button class="primary" onclick="showPage('notes')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="مصاريف ميزانية فلوس">
   <div class="emoji">💰</div><b>حاسبة المصروفات</b>
   <small>تابع ميزانيتك ومصروفاتك.</small>
   <button class="primary" onclick="showPage('budget')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="سفر قائمة تجهيز">
   <div class="emoji">🧳</div><b>قائمة السفر</b>
   <small>جهز أغراضك قبل السفر.</small>
   <button class="primary" onclick="showPage('travel')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="بطاقة طوارئ شخصية">
   <div class="emoji">🪪</div><b>بطاقة الطوارئ</b>
   <small>جهز بطاقة قابلة للطباعة.</small>
   <button class="primary" onclick="showPage('card')">افتح القسم</button>
  </div>
  <div class="card tile" data-search="دليل حكومي خدمات">
   <div class="emoji">🏛️</div><b>دليل الخدمات</b>
   <small>معلومات عن جهات وخدمات عامة.</small>
   <button class="primary" onclick="showPage('services')">افتح القسم</button>
  </div>
 </div>
 <h2 class="section-title">معلومة اليوم</h2>
 <div class="card">
  <div style="font-size:28px">💡</div>
  <b id="dailyFact">المعرفة تبدأ بسؤال!</b>
  <p class="muted">افتح الموقع كل يوم لاكتشاف معلومة جديدة.</p>
 </div>
</section>

<!-- الطوارئ -->
<section class="page" id="emergency">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>🚨 أرقام الطوارئ المصرية</h2>
 <div class="notice">إذا كان هناك خطر مباشر، اتصل بالجهة المختصة فورًا. لا تؤخر الاتصال من أجل استخدام الموقع.</div>
 <div class="card" id="emergencyList"></div>
 <p class="muted">قد تختلف أرقام الخدمات المحلية. تأكد من الجهة الرسمية عند الحاجة.</p>
</section>

<!-- الإسعافات -->
<section class="page" id="firstaid">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>🩺 التصرف في المواقف الحرجة</h2>
 <div class="notice">هذه معلومات توعوية أولية وليست بديلًا عن الإسعاف أو الطبيب. في الحالات الخطرة اتصل بالإسعاف 123.</div>
 <div class="grid" id="aidList"></div>
 <div class="card" style="margin-top:14px">
  <b>معلومة مهمة عن «بلع اللسان»</b>
  <p class="muted">اللسان لا يُبلع فعليًا. قد ينسد مجرى الهواء عند فقدان الوعي بسبب ارتخاء العضلات. لا تضع يدك أو أي شيء في الفم، ولا تحاول سحب اللسان. اطلب الإسعاف واتبع تعليمات المختص.</p>
 </div>
</section>

<!-- الأكواد -->
<section class="page" id="codes">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>📱 أكواد شركات المحمول المصرية</h2>
 <p class="muted">اختر الشركة لعرض الأكواد المتاحة. قد تتغير الأكواد أو أسعار الخدمات، لذلك تحقق من الشركة قبل الاشتراك.</p>
 <div class="row">
  <button class="primary" onclick="showCodes('vodafone')">فودافون</button>
  <button class="primary" onclick="showCodes('orange')">أورنج</button>
 </div>
 <div class="row" style="margin-top:8px">
  <button class="primary" onclick="showCodes('etisalat')">اتصالات</button>
  <button class="primary" onclick="showCodes('we')">WE</button>
 </div>
 <div class="card" id="codeResult" style="margin-top:15px">
  <p class="muted">اختر شركة لعرض الأكواد.</p>
 </div>
</section>

<!-- العمر -->
<section class="page" id="age">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>🎂 احسب عمرك</h2>
 <div class="card">
  <label>تاريخ ميلادك</label>
  <input type="date" id="birth">
  <button class="primary" onclick="calculateAge()">احسب عمري</button>
  <div id="ageResult"></div>
 </div>
</section>

<!-- QR -->
<section class="page" id="qr">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>🔳 صانع QR Code</h2>
 <div class="card">
  <p class="muted">أنشئ رمز QR لنص أو رابط قصير. يعمل محليًا دون إرسال البيانات لخدمة خارجية.</p>
  <label>اكتب النص أو الرابط</label>
  <textarea id="qrText" rows="3" maxlength="53" placeholder="مثال: https://example.com"></textarea>
  <p class="muted">الحد الأقصى 53 بايت لضمان عمل المولد المحلي المدمج.</p>
  <button class="primary" onclick="makeQR()">إنشاء QR</button>
  <div id="qrOutput" style="text-align:center;margin-top:18px"></div>
 </div>
</section>

<!-- الساعة -->
<section class="page" id="world">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>🌍 الساعة العالمية</h2>
 <p class="muted">الوقت الحالي في مدن مختلفة. نزلة سلمان والقاهرة على توقيت مصر نفسه.</p>
 <div class="grid" id="clocks"></div>
</section>

<!-- الحاسبة -->
<section class="page" id="calculator">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>🧮 الحاسبة</h2>
 <div class="card">
  <input id="calcDisplay" readonly placeholder="0" style="font-size:25px;text-align:left;direction:ltr">
  <div class="grid">
   <button class="secondary" onclick="calc('7')">7</button>
   <button class="secondary" onclick="calc('8')">8</button>
   <button class="secondary" onclick="calc('9')">9</button>
   <button class="secondary" onclick="calc('/')">÷</button>
   <button class="secondary" onclick="calc('4')">4</button>
   <button class="secondary" onclick="calc('5')">5</button>
   <button class="secondary" onclick="calc('6')">6</button>
   <button class="secondary" onclick="calc('*')">×</button>
   <button class="secondary" onclick="calc('1')">1</button>
   <button class="secondary" onclick="calc('2')">2</button>
   <button class="secondary" onclick="calc('3')">3</button>
   <button class="secondary" onclick="calc('-')">−</button>
   <button class="secondary" onclick="calc('0')">0</button>
   <button class="secondary" onclick="calc('.')">.</button>
   <button class="secondary" onclick="calculate()">=</button>
   <button class="secondary" onclick="calc('+')">+</button>
  </div>
  <button class="danger" style="width:100%;margin-top:10px" onclick="clearCalc()">مسح</button>
 </div>
</section>

<!-- تحويل -->
<section class="page" id="convert">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>📏 محوّل الوحدات</h2>
 <div class="card">
  <label>نوع التحويل</label>
  <select id="unitType" onchange="updateUnits()">
   <option value="length">الطول</option>
   <option value="weight">الوزن</option>
   <option value="temp">درجة الحرارة</option>
  </select>
  <div class="row">
   <div><label>من</label><select id="unitFrom"></select></div>
   <div><label>إلى</label><select id="unitTo"></select></div>
  </div>
  <label>القيمة</label><input id="unitValue" type="number" placeholder="اكتب القيمة">
  <button class="primary" onclick="convertUnit()">تحويل</button>
  <div class="result" id="unitResult"></div>
 </div>
</section>

<!-- كلمات المرور -->
<section class="page" id="password">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>🔐 مولّد كلمات المرور</h2>
 <div class="card">
  <label>طول كلمة المرور</label>
  <input id="passLength" type="number" min="8" max="40" value="16">
  <button class="primary" onclick="makePassword()">إنشاء كلمة مرور</button>
  <input id="passResult" readonly placeholder="كلمة المرور ستظهر هنا" dir="ltr">
  <button class="secondary" onclick="copyText(document.getElementById('passResult').value)">نسخ</button>
  <p class="muted">لا تحفظ كلمة المرور في ملاحظات عامة أو تشاركها مع الآخرين.</p>
 </div>
</section>

<!-- العد التنازلي -->
<section class="page" id="countdown">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>⏳ عداد المناسبات</h2>
 <div class="card">
  <label>اسم المناسبة</label><input id="eventName" placeholder="عيد ميلادي مثلًا">
  <label>موعد المناسبة</label><input type="datetime-local" id="eventDate">
  <button class="primary" onclick="startCountdown()">احسب الوقت</button>
  <div id="countResult" class="result"></div>
 </div>
</section>

<!-- التاريخ -->
<section class="page" id="datecalc">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>📅 حاسبة التاريخ</h2>
 <div class="card">
  <label>التاريخ الأول</label><input type="date" id="dateOne">
  <label>التاريخ الثاني</label><input type="date" id="dateTwo">
  <button class="primary" onclick="dateDifference()">احسب الفرق</button>
  <div class="result" id="dateResult"></div>
 </div>
</section>

<!-- الملاحظات -->
<section class="page" id="notes">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>📝 ملاحظاتي</h2>
 <div class="card">
  <label>اكتب ملاحظتك</label>
  <textarea id="noteText" rows="4" placeholder="اكتب هنا..."></textarea>
  <button class="primary" onclick="saveNote()">حفظ الملاحظة</button>
  <div id="noteList"></div>
  <p class="muted">الملاحظات تحفظ على هذا الجهاز والمتصفح فقط. لا تضع كلمات مرور أو بيانات شديدة الحساسية هنا.</p>
 </div>
</section>

<!-- المصروفات -->
<section class="page" id="budget">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>💰 حاسبة المصروفات</h2>
 <div class="card">
  <label>ميزانيتك</label><input type="number" id="budgetTotal" placeholder="مثال: 1000">
  <label>المبلغ المصروف</label><input type="number" id="budgetSpent" placeholder="مثال: 250">
  <button class="primary" onclick="budgetCalc()">احسب المتبقي</button>
  <div class="result" id="budgetResult"></div>
 </div>
</section>

<!-- السفر -->
<section class="page" id="travel">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>🧳 قائمة السفر</h2>
 <div class="card">
  <div id="travelList"></div>
  <label>أضف غرضًا</label><input id="travelNew" placeholder="مثال: شاحن الهاتف">
  <button class="primary" onclick="addTravel()">إضافة</button>
  <button class="secondary" onclick="resetTravel()">إعادة القائمة</button>
 </div>
</section>

<!-- بطاقة الطوارئ -->
<section class="page" id="card">
 <button class="secondary back" onclick="showPage('home')">← الرئيسية</button>
 <h2>🪪 بطاقة الطوارئ الشخصية</h2>
