 if(a<0||b<0||!$('budgetTotal').value||!$('budgetSpent').value)return alert('أدخل أرقامًا صحيحة');
 let r=a-b;
 $('budgetResult').textContent=r>=0?'المتبقي: '+r.toLocaleString('ar-EG')+' جنيه':'تجاوزت الميزانية بمقدار '+Math.abs(r).toLocaleString('ar-EG')+' جنيه';
}

/* السفر */
const defaultTravel=['بطاقة الهوية أو جواز السفر','الهاتف والشاحن','الملابس','الأدوية الشخصية إن وجدت','النقود ووسائل الدفع','مستلزمات النظافة'];
function getTravel(){return JSON.parse(localStorage.getItem('sanadTravel')||'null')||defaultTravel.map(x=>({name:x,done:false}))}
function renderTravel(){
 $('travelList').innerHTML=getTravel().map((x,i)=>`<div class="item">
 <label><input type="checkbox" style="width:auto" ${x.done?'checked':''} onchange="checkTravel(${i},this.checked)"> ${escapeHTML(x.name)}</label>
 <button class="copy" onclick="removeTravel(${i})">حذف</button></div>`).join('');
}
function checkTravel(i,v){let a=getTravel();a[i].done=v;localStorage.setItem('sanadTravel',JSON.stringify(a))}
function removeTravel(i){let a=getTravel();a.splice(i,1);localStorage.setItem('sanadTravel',JSON.stringify(a));renderTravel()}
function addTravel(){
 let t=$('travelNew').value.trim();if(!t)return;
 let a=getTravel();a.push({name:t,done:false});
 localStorage.setItem('sanadTravel',JSON.stringify(a));$('travelNew').value='';renderTravel();
}
function resetTravel(){localStorage.removeItem('sanadTravel');renderTravel()}
renderTravel();

