/* QR محلي: QR Version 3-L، حد 53 بايت */
function makeQR(){
 const text=$('qrText').value;
 if(!text)return alert('اكتب نصًا أو رابطًا أولًا');
 const bytes=new TextEncoder().encode(text);
 if(bytes.length>53)return alert('النص طويل جدًا. الحد الأقصى 53 بايت في هذا المولد المحلي.');
 try{
  const matrix=qrEncode(bytes);
  const scale=7,pad=4,n=matrix.length;
  const canvas=document.createElement('canvas');
  canvas.width=canvas.height=(n+pad*2)*scale;
  const ctx=canvas.getContext('2d');
  ctx.fillStyle='#fff';ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle='#000';
  matrix.forEach((row,y)=>row.forEach((v,x)=>{
   if(v)ctx.fillRect((x+pad)*scale,(y+pad)*scale,scale,scale);
  }));
  const url=canvas.toDataURL('image/png');
  $('qrOutput').innerHTML='<img id="qrCanvas" alt="QR Code" style="width:100%;max-width:280px" src="'+url+'"><br><button class="success" onclick="downloadQR()">تحميل الصورة</button>';
  window.currentQR=url;
 }catch(e){alert('تعذر إنشاء الرمز. جرب نصًا أقصر.')}
}
function qrEncode(bytes){
 const n=29, dataLen=55, eccLen=15;
 let bits=[];
 function push(v,len){for(let i=len-1;i>=0;i--)bits.push((v>>>i)&1)}
 push(4,4);push(bytes.length,8);
 bytes.forEach(b=>push(b,8));
 for(let i=0;i<Math.min(4,dataLen*8-bits.length);i++)bits.push(0);
 while(bits.length%8)bits.push(0);
 let data=[];
 for(let i=0;i<bits.length;i+=8){
  let v=0;for(let j=0;j<8;j++)v=(v<<1)|(bits[i+j]||0);data.push(v);
 }
 let toggle=true;
 while(data.length<dataLen){data.push(toggle?0xEC:0x11);toggle=!toggle}
 const exp=new Array(512),log=new Array(256);
 let x=1;
 for(let i=0;i<255;i++){exp[i]=x;log[x]=i;x<<=1;if(x&256)x^=0x11d}
 for(let i=255;i<512;i++)exp[i]=exp[i-255];
 const mul=(a,b)=>a&&b?exp[log[a]+log[b]]:0;
 let gen=[1];
 for(let i=0;i<eccLen;i++){
  let next=new Array(gen.length+1).fill(0);
  gen.forEach((v,j)=>{next[j]^=v;next[j+1]^=mul(v,exp[i])});
  gen=next;
 }
 let rem=new Array(eccLen).fill(0);
 data.forEach(v=>{
  const factor=v^rem[0];rem.shift();rem.push(0);
  for(let i=0;i<eccLen;i++)rem[i]^=mul(gen[i+1],factor);
 });
 const all=data.concat(rem);
 let m=Array.from({length:n},()=>Array(n).fill(null));
 const set=(r,c,v)=>{if(r>=0&&r<n&&c>=0&&c<n)m[r][c]=!!v};
 function finder(r,c){
  for(let y=-1;y<=7;y++)for(let x=-1;x<=7;x++){
   const rr=r+y,cc=c+x;
   if(rr<0||rr>=n||cc<0||cc>=n)continue;
   const inside=y>=0&&y<=6&&x>=0&&x<=6;
   const edge=y===0||y===6||x===0||x===6;
   const center=y>=2&&y<=4&&x>=2&&x<=4;
   set(rr,cc,inside&&(edge||center));
  }
 }
 finder(0,0);finder(0,n-7);finder(n-7,0);
 for(let i=8;i<n-8;i++){set(6,i,i%2===0);set(i,6,i%2===0)}
 for(let y=-2;y<=2;y++)for(let x=-2;x<=2;x++){
  const d=Math.max(Math.abs(x),Math.abs(y));
  set(22+y,22+x,d===2||d===0);
 }
 set(n-8,8,true);
 let mask=0;
 let fmt=(1<<3)|mask,remf=fmt;
 for(let i=0;i<10;i++)remf=(remf<<1)^(((remf>>>9)&1)?0x537:0);
 const format=((fmt<<10)|remf)^0x5412;
 for(let i=0;i<=5;i++)set(i,8,(format>>>i)&1);
 set(7,8,(format>>>6)&1);set(8,8,(format>>>7)&1);set(8,7,(format>>>8)&1);
 for(let i=9;i<15;i++)set(14-i,8,(format>>>i)&1);
 for(let i=0;i<8;i++)set(8,n-1-i,(format>>>i)&1);
 for(let i=8;i<15;i++)set(n-15+i,8,(format>>>i)&1);
 let stream=[];
 all.forEach(v=>{for(let i=7;i>=0;i--)stream.push((v>>>i)&1)});
 let idx=0,up=true;
 for(let right=n-1;right>=1;right-=2){
  if(right===6)right--;
  for(let j=0;j<n;j++){
   const r=up?n-1-j:j;
   for(let k=0;k<2;k++){
    const c=right-k;
    if(m[r][c]!==null)continue;
    let v=idx<stream.length?stream[idx++]:0;
    if((r+c)%2===0)v^=1;
    m[r][c]=!!v;
   }
  }
  up=!up;
 }
 return m;
}
