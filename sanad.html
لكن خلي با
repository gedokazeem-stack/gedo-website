let countdownTimer=null;
function startCountdown(){
 const d=new Date($('eventDate').value);
 if(!$('eventDate').value||isNaN(d))return alert('اختر موعدًا');
 if(countdownTimer)clearInterval(countdownTimer);
 function tick(){
  let ms=d-new Date();
  if(ms<=0){$('countResult').textContent='🎉 حان موعد المناسبة!';clearInterval(countdownTimer);return}
  let days=Math.floor(ms/86400000);
  let h=Math.floor(ms%86400000/3600000);
  let m=Math.floor(ms%3600000/60000);
  let s=Math.floor(ms%60000/1000);
  $('countResult').textContent=( $('eventName').value||'المناسبة')+
  ': '+days+' يوم، '+h+' ساعة، '+m+' دقيقة، '+s+' ثانية';
 }
 tick();countdownTimer=setInterval(tick,1000);
}

