function calculateAge(){
 const val=$('birth').value;
 if(!val)return alert('اختر تاريخ ميلادك');
 const b=new Date(val+'T00:00:00');
 const now=new Date();
 if(b>now)return alert('تاريخ الميلاد لا يمكن أن يكون في المستقبل');
 let years=now.getFullYear()-b.getFullYear();
 let months=now.getMonth()-b.getMonth();
 let days=now.getDate()-b.getDate();
 if(days<0){months--;days+=new Date(now.getFullYear(),now.getMonth(),0).getDate()}
 if(months<0){years--;months+=12}
 const total=Math.floor((now-b)/86400000);
 const next=new Date(now.getFullYear(),b.getMonth(),b.getDate());
 if(next<new Date(now.getFullYear(),now.getMonth(),now.getDate()))next.setFullYear(next.getFullYear()+1);
 const left=Math.ceil((next-now)/86400000);
 const weekday=['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'][b.getDay()];
 const events=[
 'في هذا اليوم بدأت حكاية جديدة على كوكب الأرض!',
 'في هذا اليوم قرر كوكب الأرض الاحتفال بضيفه الجديد!',
