function convertUnit(){
 let v=Number($('unitValue').value),type=$('unitType').value;
 if(!Number.isFinite(v))return alert('اكتب قيمة صحيحة');
 let a=$('unitFrom').value,b=$('unitTo').value,out;
 if(type==='temp'){
  let c=a==='مئوية'?v:a==='فهرنهايت'?(v-32)*5/9:v-273.15;
  out=b==='مئوية'?c:b==='فهرنهايت'?c*9/5+32:c+273.15;
 }else out=v*units[type][a]/units[type][b];
