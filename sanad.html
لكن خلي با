function makePassword(){
 let n=Math.max(8,Math.min(40,Number($('passLength').value)||16));
 const chars='ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%&*';
 let out='';
 const rand=new Uint32Array(n);
 if(window.crypto&&crypto.getRandomValues)crypto.getRandomValues(rand);
 else for(let i=0;i<n;i++)rand[i]=Math.random()*4294967296;
 for(let x of rand)out+=chars[x%chars.length];
 $('passResult').value=out;
}

